---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<nav class="nav shell" aria-label="メインナビゲーション">
			<a class="brand" href="#top" aria-label="KASANE ホーム">
				<span class="brand-mark">重</span>
				<span>KASANE</span>
			</a>
			<div class="nav-links">
				<a href="#story">わたしたちについて</a>
				<a href="#menu">季節のメニュー</a>
				<a href="#visit">店舗情報</a>
			</div>
			<a class="nav-action" href="mailto:hello@kasane.example">席を予約する <span>↗</span></a>
			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
				<span class="menu-toggle-label">MENU</span>
				<span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
			</button>
			<div class="mobile-menu" id="mobile-menu" aria-hidden="true" hidden>
				<div class="mobile-menu-heading"><span>INDEX</span><span>01 — 04</span></div>
				<a href="#story"><span>01</span>わたしたちについて <b>↘</b></a>
				<a href="#menu"><span>02</span>季節のメニュー <b>↘</b></a>
				<a href="#visit"><span>03</span>店舗情報 <b>↘</b></a>
				<a class="mobile-booking" href="mailto:hello@kasane.example"><span>04</span>席を予約する <b>↗</b></a>
			</div>
		</nav>

		<section class="hero shell" id="top">
			<div class="hero-copy">
				<p class="eyebrow">TEA &amp; SWEETS ATELIER / TOKYO</p>
				<h1>季節を、<br /><em>重ねる。</em></h1>
				<p class="hero-intro">ひと口の中に、今日の空気を。<br />KASANEは、茶と菓子で季節を味わう小さなアトリエです。</p>
				<a class="text-link" href="#menu">今月の景色を見る <span>↓</span></a>
			</div>
			<div class="hero-image-wrap">
				<div class="stamp">一<br />服<br />一<br />菓</div>
				<img class="hero-image" src="https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&amp;fit=crop&amp;w=1400&amp;q=85" alt="木のテーブルに置かれた日本茶と菓子" />
				<div class="image-caption"><span>01 — 春の余白</span><span>茶房 / 11:00 — 18:00</span></div>
			</div>
		</section>

		<section class="statement shell" id="story">
			<p class="section-label">OUR PHILOSOPHY / 02</p>
			<div class="statement-content">
				<h2>急がない時間が、<br /><span>いちばん贅沢。</span></h2>
				<div class="statement-body">
					<p>山の茶葉、季節の果実、手のひらでつくる菓子。素材の声を聞きながら、ひとつずつ丁寧に仕立てています。</p>
					<a class="circle-link" href="#visit" aria-label="KASANEについて詳しく見る">詳しく<br />見る <span>↗</span></a>
				</div>
			</div>
		</section>

		<section class="menu-section shell" id="menu">
			<div class="section-heading">
				<p class="section-label">SEASONAL MENU / 03</p>
				<p class="section-note">その日、その時だけの<br />小さなメニュー。</p>
			</div>
			<div class="menu-grid">
				<article class="menu-card featured-card">
					<div class="card-image tea-image"></div>
					<div class="card-info"><span>01</span><h3>薄霞 — usugasumi</h3><p>煎茶 / 白桃 / 桜葉</p><strong>¥1,800</strong></div>
				</article>
				<article class="menu-card">
					<div class="card-image sweet-image"></div>
					<div class="card-info"><span>02</span><h3>山笑う — yama warau</h3><p>抹茶 / 木の芽 / 黒糖</p><strong>¥1,600</strong></div>
				</article>
			</div>
		</section>

		<section class="visit shell" id="visit">
			<div class="visit-mark">K</div>
			<div>
				<p class="section-label">COME VISIT / 04</p>
				<h2>東京・清澄白河<br /><em>静かな路地の奥。</em></h2>
			</div>
			<div class="visit-details"><p>東京都江東区清澄 2-7-8<br />11:00 — 18:00 / 火曜定休</p><a class="text-link" href="mailto:hello@kasane.example">席を予約する <span>↗</span></a></div>
		</section>

		<footer class="footer shell"><span>© KASANE ATELIER</span><span>季節とともに、またここで。</span><a href="#top">↑ TOP</a></footer>
	</main>
</Layout>

<style>
	:global(html) { scroll-behavior: smooth; scroll-padding-top: 93px; }
	:global(body) { overflow-x: hidden; }
	main { --ink: #1e2822; --paper: #f3efe7; --red: #bd4938; --line: rgba(30, 40, 34, .2); background: var(--paper); }
	.shell { width: min(1180px, calc(100% - 72px)); margin: 0 auto; }
	.nav { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; min-height: 92px; border-bottom: 1px solid var(--line); background: var(--paper); }
	.brand { display: flex; align-items: center; gap: 11px; color: var(--ink); font: 700 12px/1 Georgia, serif; letter-spacing: .18em; text-decoration: none; }
	.brand-mark { display: grid; place-items: center; width: 29px; height: 29px; border: 1px solid var(--ink); border-radius: 50%; font: 15px/1 serif; letter-spacing: 0; }
	.nav-links { display: flex; gap: 32px; margin-left: 80px; }
	.nav-links a, .nav-action { color: var(--ink); font-size: 11px; text-decoration: none; letter-spacing: .08em; }
	.nav-links a:hover, .text-link:hover, .nav-action:hover { color: var(--red); }
	.nav-action { border-bottom: 1px solid var(--ink); padding-bottom: 7px; }
	.nav-action span, .text-link span { margin-left: 8px; font-size: 16px; }
	.menu-toggle, .mobile-menu { display: none; }
	.mobile-menu[hidden] { display: none; }
	.hero { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(40px, 8vw, 120px); align-items: center; min-height: 640px; padding: 78px 0 105px; }
	.eyebrow, .section-label { color: var(--red); font: 11px/1.4 Arial, sans-serif; letter-spacing: .16em; }
	h1, h2, h3, p { margin: 0; }
	h1 { margin: 29px 0 28px; color: var(--ink); font: 500 clamp(64px, 8vw, 110px)/.91 Georgia, serif; letter-spacing: -.055em; }
	h1 em, h2 em { color: var(--red); font-style: normal; }
	.hero-intro { color: #647066; font-size: 13px; line-height: 2; }
	.text-link { display: inline-block; margin-top: 38px; border-bottom: 1px solid var(--ink); padding-bottom: 8px; color: var(--ink); font-size: 11px; letter-spacing: .1em; text-decoration: none; }
	.hero-image-wrap { position: relative; }
	.hero-image { display: block; width: 100%; height: 480px; object-fit: cover; object-position: center; filter: saturate(.72); }
	.stamp { position: absolute; z-index: 1; top: -33px; left: -30px; display: grid; place-items: center; width: 67px; height: 67px; border: 1px solid var(--red); border-radius: 50%; color: var(--red); font: 15px/1.08 serif; text-align: center; }
	.image-caption { display: flex; justify-content: space-between; margin-top: 15px; color: #6f776d; font: 10px/1.2 Arial, sans-serif; letter-spacing: .08em; }
	.statement { border-top: 1px solid var(--line); padding: 90px 0 120px; }
	.statement-content { display: grid; grid-template-columns: 1fr 1fr; gap: 12%; margin-top: 35px; }
	h2 { font: 500 clamp(38px, 5vw, 68px)/1.05 Georgia, serif; letter-spacing: -.045em; }
	.statement-body { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; padding-top: 35px; }
	.statement-body p { max-width: 290px; color: #647066; font-size: 13px; line-height: 2.1; }
	.circle-link { display: grid; flex: 0 0 auto; place-items: center; width: 100px; height: 100px; border: 1px solid var(--red); border-radius: 50%; color: var(--red); font-size: 11px; line-height: 1.5; text-align: center; text-decoration: none; }
	.circle-link span { font-size: 15px; }
	.menu-section { border-top: 1px solid var(--line); padding: 90px 0 130px; }
	.section-heading { display: flex; justify-content: space-between; align-items: flex-start; }
	.section-note { color: #647066; font-size: 13px; line-height: 1.8; text-align: right; }
	.menu-grid { display: grid; grid-template-columns: 1.16fr .84fr; gap: 34px; align-items: end; margin-top: 55px; }
	.menu-card { background: #e8e2d7; }
	.featured-card { margin-bottom: 60px; }
	.card-image { height: 340px; background-position: center; background-size: cover; filter: saturate(.65); }
	.featured-card .card-image { height: 430px; }
	.tea-image { background-image: url('https://images.unsplash.com/photo-1515823064-d6e0c04616a7?auto=format&fit=crop&w=1000&q=80'); }
	.sweet-image { background-image: url('https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=900&q=80'); }
	.card-info { position: relative; padding: 19px 22px 23px; }
	.card-info > span { color: var(--red); font: 10px Arial, sans-serif; letter-spacing: .12em; }
	h3 { margin: 14px 0 8px; color: var(--ink); font: 500 25px Georgia, serif; }
	.card-info p { color: #647066; font-size: 11px; }
	.card-info strong { position: absolute; right: 22px; bottom: 23px; color: var(--ink); font: 12px Arial, sans-serif; font-weight: 400; }
	.visit { display: grid; grid-template-columns: 1fr 2fr 1fr; align-items: center; gap: 30px; border-top: 1px solid var(--line); padding: 90px 0; }
	.visit h2 { margin-top: 25px; font-size: clamp(34px, 4.5vw, 58px); }
	.visit-mark { color: var(--red); font: 140px/.7 Georgia, serif; }
	.visit-details { justify-self: end; color: #647066; font-size: 11px; line-height: 2; }
	.visit-details .text-link { margin-top: 22px; }
	.footer { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding: 24px 0 30px; color: #7a8178; font: 10px Arial, sans-serif; letter-spacing: .08em; }
	.footer a { color: var(--ink); text-decoration: none; }
	@media (max-width: 720px) {
		:global(html) { scroll-padding-top: 76px; }
		.shell { width: min(100% - 38px, 560px); }
		.nav { min-height: 75px; }
		.nav-links { display: none; }
		.nav-action { display: none; }
		.menu-toggle { display: flex; align-items: center; gap: 10px; border: 0; border-bottom: 1px solid var(--ink); background: transparent; padding: 9px 0 8px; color: var(--ink); cursor: pointer; font: 10px Arial, sans-serif; letter-spacing: .13em; }
		.menu-icon { display: grid; gap: 5px; width: 22px; }
		.menu-icon i { display: block; height: 1px; background: currentColor; transition: transform .2s ease; }
		.menu-toggle[aria-expanded="true"] .menu-icon i:first-child { transform: translateY(3px) rotate(45deg); }
		.menu-toggle[aria-expanded="true"] .menu-icon i:last-child { transform: translateY(-3px) rotate(-45deg); }
		.mobile-menu { position: absolute; top: 74px; right: 0; left: 0; display: grid; gap: 0; visibility: hidden; transform: translateY(-12px); border-top: 1px solid var(--line); background: var(--paper); opacity: 0; transition: opacity .25s ease, transform .25s ease, visibility .25s; }
		.mobile-menu.is-open { visibility: visible; transform: translateY(0); opacity: 1; }
		.mobile-menu-heading { display: flex; justify-content: space-between; padding: 22px 0 16px; color: var(--red); font: 10px Arial, sans-serif; letter-spacing: .14em; }
		.mobile-menu a { display: grid; grid-template-columns: 32px 1fr 20px; align-items: center; border-top: 1px solid var(--line); padding: 19px 0; color: var(--ink); font: 16px Georgia, serif; text-decoration: none; }
		.mobile-menu a span { color: var(--red); font: 10px Arial, sans-serif; letter-spacing: .08em; }
		.mobile-menu a b { justify-self: end; color: var(--red); font: 18px Georgia, serif; font-weight: 400; }
		.mobile-menu .mobile-booking { padding-bottom: 24px; }
		.hero { display: flex; flex-direction: column; align-items: stretch; gap: 55px; min-height: auto; padding: 70px 0 90px; }
		h1 { font-size: clamp(70px, 21vw, 105px); }
		.hero-image { height: 390px; }
		.stamp { top: -26px; left: -12px; }
		.statement { padding: 72px 0 90px; }
		.statement-content { display: block; margin-top: 28px; }
		.statement-body { align-items: flex-start; padding-top: 35px; }
		.circle-link { width: 84px; height: 84px; }
		.menu-section { padding: 70px 0 90px; }
		.section-heading { display: block; }
		.section-note { margin-top: 22px; text-align: left; }
		.menu-grid { display: block; margin-top: 38px; }
		.featured-card { margin-bottom: 28px; }
		.card-image, .featured-card .card-image { height: 330px; }
		.visit { display: block; padding: 70px 0; }
		.visit-mark { margin-bottom: 42px; font-size: 100px; }
		.visit-details { margin-top: 35px; }
		.footer { gap: 18px; flex-wrap: wrap; }
	}
</style>

<script>
	const menuToggle = document.querySelector('.menu-toggle');
	const mobileMenu = document.querySelector('.mobile-menu');

	menuToggle?.addEventListener('click', () => {
		const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!isOpen));
		mobileMenu?.classList.toggle('is-open', !isOpen);
		mobileMenu?.setAttribute('aria-hidden', String(isOpen));
		if (mobileMenu) {
			if (isOpen) mobileMenu.setAttribute('hidden', '');
			else mobileMenu.removeAttribute('hidden');
		}
	});

	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			menuToggle?.setAttribute('aria-expanded', 'false');
			mobileMenu.classList.remove('is-open');
			mobileMenu.setAttribute('aria-hidden', 'true');
			mobileMenu.setAttribute('hidden', '');
		});
	});
</script>
